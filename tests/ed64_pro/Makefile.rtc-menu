# Production menu with foreground collection and display-only observation.
.DEFAULT_GOAL := all
RTC_MENU_BUILD_DIR ?= build/rtc-menu-observe
RTC_MENU_OUTPUT_DIR ?= output/rtc-menu-observe
TEST_FLAGS ?=

ifneq ($(RTC_MENU_INNER),1)
.PHONY: all
all:
	$(MAKE) --no-print-directory -f tests/ed64_pro/Makefile.rtc-menu RTC_MENU_INNER=1 \
		PROJECT_NAME=N64FlashcartMenuRTCObserve BUILD_DIR="$(RTC_MENU_BUILD_DIR)" \
		OUTPUT_DIR="$(RTC_MENU_OUTPUT_DIR)" TEST_FLAGS='$(TEST_FLAGS)'
else
include Makefile

RTC_OBSERVER := $(BUILD_DIR)/rtc_menu_observer.o
N64_LDFLAGS += --wrap=display_show --wrap=joypad_poll
OBJS += $(RTC_OBSERVER)
$(RTC_OBSERVER): tests/ed64_pro/rtc_menu_observer.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(TEST_FLAGS) -c $< -o $@
$(BUILD_DIR)/$(PROJECT_NAME).elf: $(RTC_OBSERVER)
-include $(RTC_OBSERVER:.o=.d)
endif
