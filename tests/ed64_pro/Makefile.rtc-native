# Standalone, destructive-clock qualification probe. No FatFs or Pro POSIX hooks.
.DEFAULT_GOAL := all
PROJECT_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
BUILD_DIR ?= $(PROJECT_ROOT)/build/ed64-pro-rtc-native
OUTPUT_DIR ?= $(PROJECT_ROOT)/output/ed64-pro-rtc-native
TEST_FLAGS ?=
# Game-handoff observation variant (keep a separate build/output directory):
# TEST_FLAGS='-DPROBE_PRESERVE_SERVICES=1 -DPROBE_RTC_MODE=2 -DPROBE_NONCE=0x52544303u'

ifneq ($(RTC_NATIVE_INNER),1)
.PHONY: all
all:
	@mkdir -p "$(OUTPUT_DIR)"
	$(MAKE) --no-print-directory -C "$(OUTPUT_DIR)" -f "$(PROJECT_ROOT)/tests/ed64_pro/Makefile.rtc-native" \
		RTC_NATIVE_INNER=1 BUILD_DIR="$(abspath $(BUILD_DIR))" TEST_FLAGS='$(TEST_FLAGS)'
else
SOURCE_DIR := $(PROJECT_ROOT)
ifeq ($(N64_INST),)
  $(error N64_INST is not set)
endif
include $(N64_INST)/include/n64.mk
ROMNAME := rtc_native_probe
N64_ROM_TITLE := "Pro native RTC probe"
N64_ROM_SAVETYPE := none
N64_ROM_RTC := 1
N64_ROM_EXPANSIONPAK := unused
N64_ROM_REGIONFREE := 1
N64_CFLAGS += -I$(PROJECT_ROOT)/src -Wall -Wextra -Werror $(TEST_FLAGS)
OBJS := $(BUILD_DIR)/tests/ed64_pro/rtc_native_probe.o
.PHONY: all
all: $(ROMNAME).z64
	python3 -c 'from pathlib import Path; p=Path("$<"); data=bytearray(p.read_bytes()); offset=0x280000; fixture=bytes((i*37+(i>>8)*11+0x6d)&255 for i in range(1024)); assert len(data)<=offset or (len(data)==0x300000 and data[offset:offset+1024]==fixture),len(data); data.extend(bytes(0x300000-len(data))); data[offset:offset+1024]=fixture; p.write_bytes(data); assert p.stat().st_size==0x300000'
$(BUILD_DIR)/$(ROMNAME).elf: $(OBJS)
-include $(OBJS:.o=.d)
endif
