# Standalone CPU memory probe; no production menu or cartridge driver is linked.
.DEFAULT_GOAL := all

PROJECT_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
BUILD_DIR ?= $(PROJECT_ROOT)/build/rdram-hardware
OUTPUT_DIR ?= $(PROJECT_ROOT)/output/rdram-hardware

ifneq ($(RDRAM_HARDWARE_INNER),1)

.PHONY: all
all:
	@mkdir -p "$(OUTPUT_DIR)"
	$(MAKE) --no-print-directory -C "$(OUTPUT_DIR)" -f "$(PROJECT_ROOT)/tests/Makefile.rdram" \
		RDRAM_HARDWARE_INNER=1 BUILD_DIR="$(abspath $(BUILD_DIR))"

else

SOURCE_DIR := $(PROJECT_ROOT)
ifeq ($(N64_INST),)
  $(error N64_INST is not set)
endif
include $(N64_INST)/include/n64.mk

ROMNAME := rdram_hardware
N64_ROM_TITLE := "RDRAM CPU test"
N64_ROM_SAVETYPE := none
N64_ROM_RTC :=
N64_ROM_EXPANSIONPAK := unused
N64_ROM_REGIONFREE := 1
N64_ROM_REGION :=
N64_CFLAGS += -Wall -Wextra -Werror

.PHONY: all
all: $(ROMNAME).z64
$(BUILD_DIR)/$(ROMNAME).elf: $(BUILD_DIR)/tests/rdram_hardware.o
-include $(BUILD_DIR)/tests/rdram_hardware.d

endif
